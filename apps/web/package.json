{
  "name": "@camelot/web",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "tsc -p tsconfig.json --noEmit && vite build",
    "check": "tsc -p tsconfig.json --noEmit",
    "test": "vitest run",
    "preview": "vite preview",
    "wasm": "cargo build -p camelot-vision --target wasm32-unknown-unknown --release --manifest-path ../../Cargo.toml && wasm-bindgen ../../target/wasm32-unknown-unknown/release/camelot_vision.wasm --target web --out-dir src/wasm/camelot-vision/pkg --out-name camelot_vision"
  },
  "dependencies": {
    "@camelot/sync-contract": "workspace:*",
    "@mediapipe/tasks-vision": "^0.10.22",
    "idb": "^8.0.3",
    "mediabunny": "^1.57.0",
    "react": "^19.1.1",
    "react-dom": "^19.1.1",
    "react-router": "^7.9.1",
    "zustand": "^5.0.8"
  },
  "devDependencies": {
    "@testing-library/react": "^16.3.0",
    "@types/react": "^19.1.12",
    "@types/react-dom": "^19.1.9",
    "@vitejs/plugin-react": "^5.0.2",
    "jsdom": "^26.1.0",
    "vite": "^7.1.5",
    "vite-plugin-wasm": "^3.5.0",
    "vitest": "3.2.4"
  }
}
