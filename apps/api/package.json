{
  "name": "@camelot/api",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "scripts": {
    "build": "tsc -p tsconfig.build.json",
    "check": "tsc --noEmit",
    "dev": "tsx watch --env-file=.env src/index.ts",
    "start": "node --env-file-if-exists=.env dist/index.js",
    "test": "vitest run"
  },
  "dependencies": {
    "@aws-sdk/client-s3": "^3.1131.0",
    "@aws-sdk/lib-storage": "^3.1131.0",
    "@camelot/db": "workspace:*",
    "@camelot/sync-contract": "workspace:*",
    "@hono/node-server": "1.19.1",
    "@hono/zod-validator": "0.7.2",
    "better-auth": "1.7.4",
    "drizzle-orm": "0.45.2",
    "hono": "4.13.7",
    "zod": "4.1.5"
  },
  "devDependencies": {
    "@types/node": "24.3.1",
    "tsx": "4.20.5",
    "vitest": "3.2.4"
  }
}
