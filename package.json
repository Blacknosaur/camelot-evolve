{
  "name": "camelot-evolve",
  "private": true,
  "packageManager": "pnpm@10.8.1",
  "engines": { "node": ">=22" },
  "scripts": {
    "build": "turbo run build",
    "check": "turbo run check",
    "dev": "turbo run dev",
    "test": "turbo run test",
    "db:generate": "pnpm --filter @camelot/db generate",
    "db:migrate": "pnpm --filter @camelot/db migrate"
  },
  "devDependencies": {
    "turbo": "2.10.12",
    "typescript": "5.9.2"
  }
}

