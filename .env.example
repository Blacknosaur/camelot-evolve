# Copy this file to apps/api/.env for local API development.
DATABASE_URL=postgres://camelot:camelot_local@localhost:5432/camelot
BETTER_AUTH_SECRET=replace-with-at-least-32-random-characters
BETTER_AUTH_URL=http://localhost:3000
PORT=3000
MEDIA_STORAGE_PATH=/tmp/camelot-media
DEFAULT_STORAGE_PROFILE=local
# Named S3-compatible profiles. Keep credentials in deployment secrets, not organization rows.
# STORAGE_PROFILES_JSON={"minio":{"endpoint":"http://minio:9000","region":"us-east-1","bucket":"camelot","accessKeyId":"minio","secretAccessKey":"change-me","forcePathStyle":true},"r2":{"endpoint":"https://ACCOUNT.r2.cloudflarestorage.com","region":"auto","bucket":"camelot","accessKeyId":"...","secretAccessKey":"..."}}
STORAGE_PROFILES_JSON={}
PUBLIC_BASE_URL=http://localhost:3000
